[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

# Dependensi runtime datang dari paket lokal (editable) — sumber kebenaran tetap
# pyproject.toml [project.dependencies]. Jadi tidak ada duplikasi versi di sini.
[packages]
jembatan-modal = {editable = true, path = "."}

[dev-packages]
pytest = ">=8.0"
ruff = ">=0.4"

# Extra berat, dipasang saat perlu:
#   pipenv install --categories api
#   pipenv install --categories pdf
[api]
fastapi = ">=0.110"
uvicorn = {version = ">=0.29", extras = ["standard"]}
pydantic-settings = ">=2.2"

[pdf]
weasyprint = ">=61"

[requires]
python_version = "3.14"
