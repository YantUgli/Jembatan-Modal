# Salin jadi `.env` lalu isi LLM_API_KEY. `.env` sudah di-gitignore.
# Variabel dari shell selalu menang atas berkas ini.

# ── Groq (default; tier gratis, paling cepat) ──
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# ── Qwen / DashScope (mode kompatibel OpenAI) ──
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ── Fireworks AI ──
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# ⚠️ Cek kebijakan retensi/pelatihan tier gratis sebelum data pengguna
# sungguhan lewat sini — ini catatan keuangan UMKM (omzet, utang, prive).

# DATABASE_URL=postgresql+psycopg://...
